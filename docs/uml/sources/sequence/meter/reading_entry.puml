@startuml
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontSize 13
skinparam dpi 180

actor "Owner / Member" as user
participant "Web UI (/readings)" as ui
participant "FastAPI Router\n(POST /api/readings)" as router
participant "BillingService" as billing
database "PostgreSQL\n(meter_readings & bills)" as db

title Sơ đồ Trình tự UC-READING-ENTRY: Ghi nhận chỉ số công tơ

user -> ui: 1. Chọn công tơ & Nhập chỉ số mới (chốt kỳ)
user -> ui: 2. Bấm "Ghi nhận chỉ số"
activate ui
ui -> router: 3. POST /api/readings {meter_id, current_reading, reading_date}
activate router

router -> db: 4. SELECT * FROM meter_readings WHERE meter_id = ? ORDER BY reading_date DESC LIMIT 1
activate db
db --> router: 5. Lượt ghi trước (previous_reading)
deactivate db

alt Chỉ số mới < Chỉ số trước (Lỗi dữ liệu)
    router --> ui: HTTP 400 Bad Request {message: "Chỉ số mới phải lớn hơn hoặc bằng chỉ số kỳ trước"}
    ui --> user: Cảnh báo số đo không hợp lệ
else Chỉ số mới hợp lệ (Current >= Previous)
    router -> router: 6. Tính sản lượng tiêu thụ C = current_reading - previous_reading
    router -> db: 7. INSERT INTO meter_readings (meter_id, previous_reading, current_reading, consumption)
    activate db
    db --> router: 8. Reading record mới
    deactivate db

    router -> billing: 9. create_bill_for_reading(household_id, meter_reading)
    activate billing
    billing -> db: 10. INSERT INTO bills (household_id, consumption, final_amount, status='UNPAID')
    activate db
    db --> billing: 11. Bill record vừa khởi tạo
    deactivate db
    billing --> router: 12. Bill created OK
    deactivate billing

    router --> ui: 13. HTTP 200 OK {reading, generated_bill}
    deactivate router

    ui --> user: 14. Hiển thị thông báo ghi số thành công & hóa đơn được tự động tính
    deactivate ui
end
@enduml

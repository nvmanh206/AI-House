@startuml
left to right direction
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam shadowing false
skinparam defaultFontSize 14
skinparam dpi 180

actor "Chủ hộ (Owner)" as owner
actor "Thành viên (Member)" as member
actor "Hệ thống (System)" as system <<System>>

rectangle "Phân hệ 3: Quản lý Công tơ & Ghi nhận Chỉ số (Meter)" {
    usecase "UC-METER-MGMT\nKhai báo & Quản lý Danh mục Công tơ" as UC_MeterMgmt
    usecase "UC-METER-UPDATE\nCập nhật Thông số & Trạng thái Công tơ" as UC_MeterUpdate
    usecase "UC-READING-ENTRY\nGhi nhận Chỉ số Công tơ Hàng tháng" as UC_ReadingEntry
    usecase "UC-VALIDATE-READING\nKiểm tra Chỉ số Hợp lệ" as UC_ValidateReading
    usecase "UC-BILL-CALCULATION\nTự động Tính tiền Bậc thang" as UC_BillCalc
}

owner -- UC_MeterMgmt
member -- UC_MeterMgmt
owner -- UC_MeterUpdate
owner -- UC_ReadingEntry
member -- UC_ReadingEntry
UC_BillCalc -- system

UC_MeterUpdate ..> UC_MeterMgmt : <<extend>>
UC_ReadingEntry ..> UC_ValidateReading : <<include>>
UC_ReadingEntry ..> UC_BillCalc : <<include>>
@enduml

@startuml
left to right direction
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam shadowing false
skinparam defaultFontSize 14
skinparam dpi 180

actor "Guest / User" as user
actor "FastAPI Auth Service" as authService <<System>>

rectangle "Hệ thống Quản lý Hóa đơn Nhà Mình - Phân hệ Xác thực" {
    usecase "UC-LOGIN\nĐăng nhập & Cấp Session JWT" as UC_Login
    usecase "UC-VERIFY-CREDENTIALS\nXác thực Email & Bcrypt Password" as UC_Verify
    usecase "UC-REFRESH-TOKEN\nCấp mới Access Token" as UC_Refresh
}

user -- UC_Login
UC_Login -- authService

UC_Login ..> UC_Verify : <<include>>
UC_Refresh ..> UC_Login : <<extend>>
@enduml

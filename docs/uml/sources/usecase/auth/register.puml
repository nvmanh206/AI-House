@startuml
left to right direction
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam shadowing false
skinparam defaultFontSize 14
skinparam dpi 180

actor "Guest" as guest
actor "FastAPI Auth Service" as authService <<System>>

rectangle "Hệ thống Quản lý Hóa đơn Nhà Mình - Phân hệ Đăng ký" {
    usecase "UC-REGISTER\nĐăng ký Tài khoản Người dùng" as UC_Register
    usecase "UC-VALIDATE-USER-INPUT\nKiểm tra Email & Định dạng Mật khẩu" as UC_Validate
}

guest -- UC_Register
UC_Register -- authService

UC_Register ..> UC_Validate : <<include>>
@enduml

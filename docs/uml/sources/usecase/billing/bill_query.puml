@startuml
left to right direction
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam shadowing false
skinparam defaultFontSize 14
skinparam dpi 180

actor "Chủ hộ (Owner)" as owner
actor "Thành viên (Member)" as member

rectangle "Hệ thống Quản lý Hóa đơn Nhà Mình - Tra cứu & Chi tiết Hóa đơn" {
    usecase "UC-BILL-QUERY\nTruy vấn Lịch sử & Chi tiết Hóa đơn" as UC_BillQuery
    usecase "UC-EXPORT-PDF\nKết xuất & Tải Hóa đơn PDF" as UC_ExportPDF
}

owner -- UC_BillQuery
member -- UC_BillQuery

UC_ExportPDF ..> UC_BillQuery : <<extend>>
@enduml

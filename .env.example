# Optional: docker compose up -d --build works without this file.
# Copy to .env only to enable Gemini or override local development settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUESTS_PER_MINUTE=12
GEMINI_REPLY_TOKENS=2048
# Defaults bind to this computer only. These are local-development credentials.
POSTGRES_PASSWORD=utility_local_dev
KNOWLEDGE_POSTGRES_PASSWORD=knowledge_local_dev
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=LocalPgAdmin2026!
FRONTEND_PORT=3000
API_PORT=8000
POSTGRES_PORT=5434
KNOWLEDGE_POSTGRES_PORT=5435
PGADMIN_PORT=5050
# Leave unset: Docker generates a JWT secret once in runtime_data.
